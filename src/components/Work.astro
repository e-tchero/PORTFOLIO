---
import { projects } from "../data/projects";
---

<section class="work shell section" id="work" aria-labelledby="work-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">SELECTED WORK / 2024—2026</p>
      <h2 id="work-title">Projects with<br /><em>a purpose.</em></h2>
    </div>
    <p class="aside">
      A selection of engineering projects and initiatives across software development, security, and business systems.
    </p>
  </div>

  <ul class="project-list">
    {
      projects.map((p) => (
        <li>
          <a class="project" href={p.url} target="_blank" rel="noopener noreferrer">
            <span class="number">{p.n}</span>
            <span class="project-main">
              <h3>{p.name}</h3>
              <small>{p.tag}</small>
              <span class="desc">{p.desc}</span>
            </span>
            <span class="state">{p.state}</span>
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
