---
import "../styles/global.css";
import "../styles/i18n.css";
import { zh } from "../i18n/translations";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Abdulhameed Aminu — Software Developer",
  description = "Abdulhameed Aminu — Software Developer, Security Researcher, and Founder at ETCHERO. Selected projects and professional work.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.jpg", Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abdulhameed Aminu",
  jobTitle: "Software Developer",
  url: Astro.site?.href,
  image: ogImage,
  address: { "@type": "PostalAddress", addressLocality: "Abuja", addressCountry: "NG" },
  worksFor: { "@type": "Organization", name: "ETCHERO", url: "https://etchero.ct.ws" },
  sameAs: [
    "https://github.com/e-tchero",
    "https://www.linkedin.com/in/abdulhameed-aminu",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="FJOjKgzhI7RwQXwSDCUmnRjzPdCrpBRTGJl-Z8t85-0" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f2f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171816" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Abdulhameed Aminu" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Building practical software, security tools, and useful digital products." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Abdulhameed Aminu — Software Developer and Founder at ETCHERO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Building practical software, security tools, and useful digital products." />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="a11y.skip">Skip to content</a>
    <slot />

    <script
      is:inline
      define:vars={{
        dict: zh,
        zhTitle: zh["meta.title"],
        zhDescription: zh["meta.description"],
        defaultTitle: title,
        defaultDescription: description,
      }}
    >
      // Bilingual toggle: English is rendered in the markup, Chinese comes from
      // src/i18n/translations.ts. This runs while the document is still parsing
      // (end of <body>), so the chosen language is applied before first paint.
      (function () {
        var root = document.documentElement;
        var STORAGE_KEY = "portfolio-lang";

        var nodes = Array.prototype.slice
          .call(document.querySelectorAll("[data-i18n],[data-i18n-html],[data-i18n-attr]"))
          .map(function (el) {
            var attrs = [];
            if (el.dataset.i18nAttr) {
              el.dataset.i18nAttr.split(",").forEach(function (pair) {
                var at = pair.indexOf(":");
                if (at === -1) return;
                var attr = pair.slice(0, at).trim();
                if (!attr) return;
                attrs.push({
                  attr: attr,
                  key: pair.slice(at + 1).trim(),
                  original: el.getAttribute(attr),
                });
              });
            }
            return { el: el, html: el.innerHTML, attrs: attrs };
          });

        function apply(lang) {
          var isZh = lang === "zh";

          nodes.forEach(function (node) {
            var el = node.el;
            var key = el.dataset.i18n || el.dataset.i18nHtml;
            var value = (isZh && key && dict[key]) || "";

            if (el.dataset.i18nHtml) {
              el.innerHTML = value || node.html;
            } else if (el.dataset.i18n) {
              el.textContent = value || node.html;
            }

            node.attrs.forEach(function (item) {
              var translated = isZh && dict[item.key];
              if (translated) el.setAttribute(item.attr, translated);
              else if (item.original !== null) el.setAttribute(item.attr, item.original);
            });
          });

          root.setAttribute("data-lang", lang);
          root.lang = isZh ? "zh-Hans" : "en";
          document.title = isZh ? zhTitle : defaultTitle;

          var meta = document.querySelector('meta[name="description"]');
          if (meta) meta.setAttribute("content", isZh ? zhDescription : defaultDescription);

          Array.prototype.forEach.call(
            document.querySelectorAll("[data-lang-set]"),
            function (button) {
              button.setAttribute(
                "aria-pressed",
                button.getAttribute("data-lang-set") === lang ? "true" : "false",
              );
            },
          );

          // The theme control's label is localised too.
          updateThemeButton();

          try {
            localStorage.setItem(STORAGE_KEY, lang);
          } catch (error) {
            /* Private mode or blocked storage: the toggle still works for this visit. */
          }

          document.dispatchEvent(new CustomEvent("portfolio:lang", { detail: { lang: lang } }));
        }

        function initialLang() {
          try {
            var saved = localStorage.getItem(STORAGE_KEY);
            if (saved === "en" || saved === "zh") return saved;
          } catch (error) {
            /* Fall through to the browser preference. */
          }
          return String(navigator.language || "en").toLowerCase().indexOf("zh") === 0 ? "zh" : "en";
        }

        // --- Theme: system (default) / light / dark -------------------------
        var THEME_KEY = "portfolio-theme";
        var THEME_COLORS = { light: "#f2f1ec", dark: "#171816" };
        var THEME_GLYPHS = { system: "◐", light: "☀", dark: "☾" };
        var THEME_LABELS = {
          system: "Theme: system",
          light: "Theme: light",
          dark: "Theme: dark",
        };
        var themeButton = document.querySelector("[data-theme-cycle]");
        var currentTheme = "system";

        function prefersDark() {
          return !!(
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
          );
        }

        // Keep the browser chrome colour in step with the effective theme.
        function paintThemeColor() {
          var effective =
            currentTheme === "system" ? (prefersDark() ? "dark" : "light") : currentTheme;
          Array.prototype.forEach.call(
            document.querySelectorAll('meta[name="theme-color"]'),
            function (meta) {
              meta.setAttribute("content", THEME_COLORS[effective]);
            },
          );
        }

        function updateThemeButton() {
          if (!themeButton) return;
          var name = THEME_GLYPHS[currentTheme] ? currentTheme : "system";
          var label =
            root.getAttribute("data-lang") === "zh" && dict["theme." + name]
              ? dict["theme." + name]
              : THEME_LABELS[name];
          themeButton.setAttribute("data-theme-state", currentTheme);
          themeButton.textContent = THEME_GLYPHS[name];
          themeButton.setAttribute("aria-label", label);
          themeButton.setAttribute("title", label);
        }

        function applyTheme(mode) {
          currentTheme = mode === "light" || mode === "dark" ? mode : "system";
          root.setAttribute("data-theme", currentTheme);
          paintThemeColor();
          updateThemeButton();
          try {
            localStorage.setItem(THEME_KEY, currentTheme);
          } catch (error) {
            /* Storage blocked: the choice still applies to this visit. */
          }
        }

        function initialTheme() {
          try {
            var saved = localStorage.getItem(THEME_KEY);
            if (saved === "light" || saved === "dark" || saved === "system") return saved;
          } catch (error) {
            /* Fall through to following the device. */
          }
          return "system";
        }

        // In system mode, follow the device when it changes mid-visit.
        if (window.matchMedia) {
          window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", function () {
              if (currentTheme === "system") paintThemeColor();
            });
        }

        // Used by the contact form for its status messages.
        window.__pfT = function (key) {
          return (root.getAttribute("data-lang") === "zh" && dict[key]) || "";
        };

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!target || !target.closest) return;

          var langButton = target.closest("[data-lang-set]");
          if (langButton) {
            event.preventDefault();
            apply(langButton.getAttribute("data-lang-set"));
            return;
          }

          if (target.closest("[data-theme-cycle]")) {
            event.preventDefault();
            applyTheme(
              currentTheme === "system" ? "light" : currentTheme === "light" ? "dark" : "system",
            );
          }
        });

        apply(initialLang());
        applyTheme(initialTheme());
      })();
    </script>
  </body>
</html>
