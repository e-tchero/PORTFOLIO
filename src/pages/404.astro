---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found — Abdulhameed Amin" description="This page could not be found.">
  <Header />
  <main id="main" class="shell not-found">
    <p class="eyebrow"><b aria-hidden="true"></b> 404</p>
    <h1>Nothing<br />here <em>yet.</em></h1>
    <p class="intro">The page you were looking for doesn't exist or has moved.</p>
    <div class="actions">
      <a class="button" href="/">Back to the portfolio <span aria-hidden="true">↖</span></a>
    </div>
  </main>
  <Footer />
</Base>
